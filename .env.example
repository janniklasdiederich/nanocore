# Server
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
# Optional: set in production for cookie signing / session strength
SESSION_SECRET=change-me-in-production

# --- Web (Vite / start:web) ---
# Put this file at the monorepo ROOT (next to package.json).
#
# start:web writes dist/config.js from these vars (no rebuild required).
# build:web also bakes VITE_* into the JS bundle (envDir = monorepo root).
#
# When UI is on :4173 and API on :3001 you MUST set these, e.g.:
# VITE_API_URL=http://YOUR_SERVER_IP:3001
# VITE_WS_URL=ws://YOUR_SERVER_IP:3001
#
# Leave empty only when UI and API share the same origin.
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001

# WEB_PORT=4173
# WEB_HOST=0.0.0.0

