# =============================================================================
# Nanocore environment
# Copy to `.env` for local docker compose / bare-metal runs.
# =============================================================================

# --- Server ---
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
NODE_ENV=development

# Cookie signing. Docker: leave as "auto" (or unset) to auto-generate into the volume.
# Bare-metal production: set a long random string, e.g.  openssl rand -hex 32
SESSION_SECRET=auto

# Secure cookies (HTTPS only). Docker HTTP → false. Behind HTTPS reverse proxy → true
COOKIE_SECURE=false

# Optional public site URL (used for COOKIE_SECURE=auto detection if you set https://…)
# PUBLIC_URL=https://boards.example.com

# Cross-origin SPA only. Docker same-origin (recommended) → leave empty.
# ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=

# Max upload size in bytes (default 15 MiB)
MAX_UPLOAD_BYTES=15728640

# --- Dev / split UI (NOT needed for Docker single-port) ---
# When Vite (:5173 / :4173) is separate from the API (:3001):
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001
# WEB_PORT=4173
# WEB_HOST=0.0.0.0
