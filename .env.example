# Server
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
# Optional: set in production for cookie signing / session strength
SESSION_SECRET=change-me-in-production

# --- Web (Vite) ---
# Baked into the client at build time (prefix VITE_).
# Leave empty when UI and API share the same origin (recommended).
# VITE_API_URL=http://localhost:3001
# Optional WebSocket override (defaults from VITE_API_URL, or ws://localhost:3001 in dev)
# VITE_WS_URL=ws://localhost:3001

# Port for `bun run start:web` (vite preview). Dev uses 5173 if unset.
# WEB_PORT=4173
# WEB_HOST=0.0.0.0
